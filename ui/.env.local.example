# API base URL the UI talks to.
#
# Leave UNSET for single-host deploys (Next dev / static SPA on the same
# origin as the API). The UI will hit /api/... at the same origin it was
# served from.
#
# For split-host deploys (UI on host A, API on host B), set this to the
# absolute API URL at build time AND set BOARD_CORS_ALLOWED_ORIGINS on
# the API host so it accepts the UI's origin.
#NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Legacy alias for NEXT_PUBLIC_API_BASE_URL — still honored when set.
#NEXT_PUBLIC_BOARD_SERVER_URL=http://localhost:3031
