# Anthropic API — OPTIONAL.
#
# Leave both blank to use your `claude` CLI login session (default).
# Set ANTHROPIC_API_KEY only when you need bare-mode auth — proxy / multi-host
# / non-interactive operation. ANTHROPIC_BASE_URL is optional even in bare mode
# (claude has a built-in default); set it only to point at a custom proxy.
#ANTHROPIC_BASE_URL=http://localhost:20128/v1
#ANTHROPIC_API_KEY=

# Telegram (optional — 빈값이면 silent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server / UI ports
BOARD_SERVER_PORT=3031
BOARD_UI_PORT=3030

# CORS allowlist for split-host deploys (UI on a separate origin from API).
# Leave empty for the single-host default (localhost:<BOARD_UI_PORT> +
# 127.0.0.1:<BOARD_UI_PORT> are always allowed). Comma-separated list of
# absolute origins. "*" is rejected at boot.
#BOARD_CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Worker / reviewer helper CLI — base URL of the board server.
# Dispatcher passes this through to spawned workers; the CLI also
# accepts `--server <url>` as a per-invocation override.
BOARD_SERVER_URL=http://localhost:3031

# Concurrency
BOARD_CONCURRENCY=8

# Git
# Optional base branch override. If unset, questboard tries origin/main, main,
# master, then HEAD.
#BOARD_BASE_BRANCH=main

# Paths
# BOARD_ROOT is optional. Leave it commented to default to the project root
# (the directory containing .questboard/.env). Do NOT set it to an empty
# value — that resolves to the process cwd.
# BOARD_ROOT=/absolute/path/to/repository
BOARD_DATA=.questboard/data
BOARD_WORKTREES=.questboard/worktrees
