{
  "name": "questboard",
  "version": "0.1.1",
  "description": "Companion app that runs multiple Claude Code workers in parallel against your Git repository, with a kanban-style review board.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "homepage": "https://github.com/bsangs/questboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsangs/questboard.git"
  },
  "bugs": {
    "url": "https://github.com/bsangs/questboard/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "kanban",
    "worker-pool",
    "git-worktree"
  ],
  "bin": {
    "questboard": "board/worker-tools/bin/questboard.mjs"
  },
  "files": [
    "board/dispatcher/dist/**",
    "board/server/dist/**",
    "board/worker-tools/dist/**",
    "board/worker-tools/bin/**",
    "board/prompts/**",
    "board/core/src/schema.sql",
    "ui/.next/BUILD_ID",
    "ui/.next/*.json",
    "ui/.next/*.js",
    "ui/.next/server/**",
    "ui/.next/static/**",
    "ui/.next/types/**",
    "ui/.next/package.json",
    "ui/public/**",
    "ui/package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./board/*\" build && pnpm --filter ./ui build",
    "dev:server": "pnpm --filter ./board/server dev",
    "dev:dispatcher": "pnpm --filter ./board/dispatcher dev",
    "dev:ui": "pnpm --filter ./ui dev",
    "typecheck": "pnpm -r --filter \"./board/*\" typecheck",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "fastify": "^4.28.1",
    "lucide-react": "^0.453.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.22.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
